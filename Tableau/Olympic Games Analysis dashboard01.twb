    <worksheet name='Host Country Medal Performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='athlete_events' name='federated.09u38pp1hcjbce11xb81n0x3hjgd' />
          </datasources>
          <datasource-dependencies datasource='federated.09u38pp1hcjbce11xb81n0x3hjgd'>
            <column caption='Medal Count' datatype='integer' name='[Calculation_0735359741140992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Medal])&#13;&#10;AND [Medal] &lt;&gt; &quot;NA&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column aggregation='CountD' caption='Unique Medal Key' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_0735359741681665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0735359741140992] = 1 THEN&#13;&#10;STR([Year]) + &quot;|&quot; +&#13;&#10;[Season] + &quot;|&quot; +&#13;&#10;[Event] + &quot;|&quot; +&#13;&#10;[NOC] + &quot;|&quot; +&#13;&#10;[Medal]&#13;&#10;END' />
            </column>
            <column caption='Host Nation Medal Key' datatype='string' name='[Calculation_0735360040140805]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [NOC] = [Calculation_0735360041832456] THEN&#13;&#10;    [Calculation_0735359741681665]&#13;&#10;END' />
            </column>
            <column caption='Host NOC' datatype='string' name='[Calculation_0735360041832456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [City]&#13;&#10;WHEN &quot;Athens&quot; THEN &quot;GRE&quot;&#13;&#10;WHEN &quot;Paris&quot; THEN &quot;FRA&quot;&#13;&#10;WHEN &quot;London&quot; THEN &quot;GBR&quot;&#13;&#10;WHEN &quot;Los Angeles&quot; THEN &quot;USA&quot;&#13;&#10;WHEN &quot;Atlanta&quot; THEN &quot;USA&quot;&#13;&#10;WHEN &quot;Beijing&quot; THEN &quot;CHN&quot;&#13;&#10;WHEN &quot;Tokyo&quot; THEN &quot;JPN&quot;&#13;&#10;WHEN &quot;Seoul&quot; THEN &quot;KOR&quot;&#13;&#10;WHEN &quot;Sydney&quot; THEN &quot;AUS&quot;&#13;&#10;WHEN &quot;Melbourne&quot; THEN &quot;AUS&quot;&#13;&#10;WHEN &quot;Rio de Janeiro&quot; THEN &quot;BRA&quot;&#13;&#10;WHEN &quot;Barcelona&quot; THEN &quot;ESP&quot;&#13;&#10;WHEN &quot;Rome&quot; THEN &quot;ITA&quot;&#13;&#10;WHEN &quot;Berlin&quot; THEN &quot;GER&quot;&#13;&#10;WHEN &quot;Munich&quot; THEN &quot;GER&quot;&#13;&#10;WHEN &quot;Moscow&quot; THEN &quot;URS&quot;&#13;&#10;WHEN &quot;Montreal&quot; THEN &quot;CAN&quot;&#13;&#10;WHEN &quot;Vancouver&quot; THEN &quot;CAN&quot;&#13;&#10;WHEN &quot;Toronto&quot; THEN &quot;CAN&quot;&#13;&#10;WHEN &quot;Mexico City&quot; THEN &quot;MEX&quot;&#13;&#10;WHEN &quot;Helsinki&quot; THEN &quot;FIN&quot;&#13;&#10;WHEN &quot;Stockholm&quot; THEN &quot;SWE&quot;&#13;&#10;WHEN &quot;Amsterdam&quot; THEN &quot;NED&quot;&#13;&#10;WHEN &quot;Antwerp&quot; THEN &quot;BEL&quot;&#13;&#10;WHEN &quot;St. Louis&quot; THEN &quot;USA&quot;&#13;&#10;WHEN &quot;Munich&quot; THEN &quot;GER&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
