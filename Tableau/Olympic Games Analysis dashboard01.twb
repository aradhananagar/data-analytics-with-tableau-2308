    <dashboard name='Olympic Games Data Analysis – Story' type='storyboard'>
      <style />
      <size maxheight='1300' maxwidth='1700' minheight='1300' minwidth='1700' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98770' id='1' param='vert' removable='false' type-v2='layout-flow' w='99058' x='471' y='615'>
            <zone h='3231' id='3' type-v2='title' w='99058' x='471' y='615' />
            <zone h='7769' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99058' x='471' y='3846' />
            <zone h='87770' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99058' x='471' y='11615'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Olympic Games – Project Overview' captured-sheet='Sports Performance Analysis' id='1' />
                  <story-point caption='Scenario 1 – Global  Olympic Performance Analysis' captured-sheet='Global Olympic Performance Analysis.' id='2' />
                  <story-point caption='Scenario 2 – Sports Performance and Regional Efficiency' captured-sheet='Sports Performance Analysis' id='3'>
                    <capturedDeltas>
                      <worksheet name='Regional Medal Efficiency'>
                        <selection-collection />
