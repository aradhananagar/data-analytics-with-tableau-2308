                <zone h='92253' id='8' type-v2='text' w='97538' x='1231' y='6808'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Olympic Games Data Analysis</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Project Objective:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> To analyze historical Olympic Games data and understand medal distribution, country performance, sports participation, regional efficiency, and Olympic trends.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Dataset:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> Historical Olympic Games athlete data (analysis period: 1992–2016).</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tools Used:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> Tableau for data visualization and dashboard creation.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key Analysis Areas:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>National Olympic Performance</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Sports Participation and Medal Performance</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Regional Medal Efficiency</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Historical Olympic Medal Trends</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Host Nation Medal Performance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Project Output:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> 9 Visualizations, 3 Analytical Dashboards, and 4 Tableau Story Points.</run>
                  </formatted-text>
