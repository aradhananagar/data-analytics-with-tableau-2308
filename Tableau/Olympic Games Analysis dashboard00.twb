                </zone>
                <zone h='92253' id='8' type-v2='text' w='97538' x='1231' y='6808'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Olympic Games Data Analysis</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Project Objective:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> To analyze historical Olympic Games data and understand medal distribution, country performance, sports participation, regional efficiency, and Olympic trends.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Dataset:</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> Historical Olympic Games athlete data (analysis period: 1992–2016).</run>
                    <run>Æ&#10;</run>
